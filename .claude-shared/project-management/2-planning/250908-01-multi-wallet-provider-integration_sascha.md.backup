## Service Layer Implementation

### 1. Wallet Provider Abstraction Service

**File**: `api/services/walletProvider.service.ts`

```typescript
import { Web3AuthService } from './web3auth.service';
import { TurnkeyService } from './turnkey.service';
import { DfnsService } from './dfns.service';

interface WalletProviderInterface {
  authenticateUser(token: string): Promise<AuthResult>;
  createWallet(userId: string): Promise<WalletResult>;
  signTransaction(userId: string, transaction: any): Promise<SignatureResult>;
  getUserWallets(userId: string): Promise<WalletInfo[]>;
}

export class WalletProviderService {
  private providers = new Map<string, WalletProviderInterface>([
    ['web3auth', new Web3AuthService()],
    ['turnkey', new TurnkeyService()],
    ['dfns', new DfnsService()]
  ]);

  async authenticateWithProvider(
    provider: string, 
    token: string, 
    userType: string
  ): Promise<AuthResult> {
    // Validate provider access based on user type
    this.validateProviderAccess(provider, userType);
    
    const service = this.providers.get(provider);
    if (!service) {
      throw new Error(`Unsupported wallet provider: ${provider}`);
    }
    
    return await service.authenticateUser(token);
  }

  private validateProviderAccess(provider: string, userType: string): void {
    // Retail users can only use Web3Auth
    if (userType === 'Retail' && provider !== 'web3auth') {
      throw new Error('Retail users can only use Web3Auth');
    }
    
    // Accredited/Institutional can use all providers
    if (['Accredited', 'Institutional'].includes(userType)) {
      return; // All providers allowed
    }
    
    // Default to Web3Auth for unknown user types
    if (provider !== 'web3auth') {
      throw new Error('Only Web3Auth is available for your user type');
    }
  }

  async getAvailableProviders(userType: string): Promise<string[]> {
    switch (userType) {
      case 'Retail':
        return ['web3auth'];
      case 'Accredited':
      case 'Institutional':
        return ['web3auth', 'turnkey', 'dfns'];
      default:
        return ['web3auth'];
    }
  }
}
```

### 2. Turnkey Integration Service

**File**: `api/services/turnkey.service.ts`

```typescript
import { TurnkeyApiClient } from '@turnkey/sdk-server';
import * as jose from 'jose';

export class TurnkeyService implements WalletProviderInterface {
  private client: TurnkeyApiClient;

  constructor() {
    this.client = new TurnkeyApiClient({
      apiBaseUrl: 'https://api.turnkey.com',
      defaultOrganizationId: process.env.TURNKEY_ORGANIZATION_ID!
    });
  }

  async authenticateUser(token: string): Promise<AuthResult> {
    try {
      // Verify Turnkey JWT token
      const { payload } = await jose.jwtVerify(
        token, 
        await jose.importJWK(JSON.parse(process.env.TURNKEY_PUBLIC_JWK!))
      );

      // Extract user information from Turnkey payload
      const userId = payload.sub as string;
      const walletId = payload.walletId as string;
      const publicKey = payload.publicKey as string;
      
      // Generate Ethereum address from public key
      const walletAddress = this.deriveEthereumAddress(publicKey);

      return {
        success: true,
        user: {
          providerId: userId,
          walletId,
          publicKey,
          walletAddress,
          provider: 'turnkey'
        }
      };
    } catch (error) {
      logger.error('Turnkey authentication failed:', error);
      return { success: false, error: 'Turnkey authentication failed' };
    }
  }

  async createWallet(userId: string): Promise<WalletResult> {
    try {
      const response = await this.client.createWallet({
        organizationId: process.env.TURNKEY_ORGANIZATION_ID!,
        walletName: `penomo-wallet-${userId}`,
        accounts: [{
          curve: 'CURVE_SECP256K1',
          pathFormat: 'PATH_FORMAT_BIP32',
          path: "m/44'/60'/0'/0/0" // Ethereum derivation path
        }]
      });

      return {
        success: true,
        walletId: response.walletId,
        address: response.addresses[0],
        publicKey: response.publicKeys[0]
      };
    } catch (error) {
      logger.error('Turnkey wallet creation failed:', error);
      return { success: false, error: 'Wallet creation failed' };
    }
  }

  private deriveEthereumAddress(publicKey: string): string {
    // Implement Ethereum address derivation from public key
    // Using the same logic as in the existing Web3Auth middleware
    // ... (implementation details)
    return address;
  }
}
```

### 3. DFNS Integration Service

**File**: `api/services/dfns.service.ts`

```typescript
import { DfnsApiClient } from '@dfns/sdk-ts';

export class DfnsService implements WalletProviderInterface {
  private client: DfnsApiClient;

  constructor() {
    this.client = new DfnsApiClient({
      appId: process.env.DFNS_APP_ID!,
      authToken: process.env.DFNS_AUTH_TOKEN!,
      baseUrl: 'https://api.dfns.co'
    });
  }

  async authenticateUser(token: string): Promise<AuthResult> {
    try {
      // Verify DFNS token and extract user information
      const userInfo = await this.client.auth.verifyToken(token);
      
      // Get user's wallets
      const wallets = await this.client.wallets.listWallets({
        userId: userInfo.userId
      });

      const primaryWallet = wallets.find(w => w.network === 'Polygon') || wallets[0];

      return {
        success: true,
        user: {
          providerId: userInfo.userId,
          walletId: primaryWallet.walletId,
          publicKey: primaryWallet.publicKey,
          walletAddress: primaryWallet.address,
          provider: 'dfns'
        }
      };
    } catch (error) {
      logger.error('DFNS authentication failed:', error);
      return { success: false, error: 'DFNS authentication failed' };
    }
  }

  async createWallet(userId: string): Promise<WalletResult> {
    try {
      const wallet = await this.client.wallets.createWallet({
        network: 'Polygon',
        name: `penomo-wallet-${userId}`,
        userId: userId
      });

      return {
        success: true,
        walletId: wallet.walletId,
        address: wallet.address,
        publicKey: wallet.publicKey
      };
    } catch (error) {
      logger.error('DFNS wallet creation failed:', error);
      return { success: false, error: 'Wallet creation failed' };
    }
  }

  async signTransaction(userId: string, transaction: any): Promise<SignatureResult> {
    try {
      // ERC-3643 compliant transaction signing
      const signature = await this.client.wallets.signTransaction({
        walletId: transaction.walletId,
        body: {
          kind: 'Evm',
          to: transaction.to,
          value: transaction.value,
          data: transaction.data,
          nonce: transaction.nonce,
          gasLimit: transaction.gasLimit,
          gasPrice: transaction.gasPrice
        }
      });

      return {
        success: true,
        signature: signature.signedData,
        transactionHash: signature.transactionHash
      };
    } catch (error) {
      logger.error('DFNS transaction signing failed:', error);
      return { success: false, error: 'Transaction signing failed' };
    }
  }
}
```

## Middleware Enhancement

### Updated Authentication Middleware

**File**: `api/middleware/verifyApiKeyOrWalletToken.middleware.ts`

```typescript
import { WalletProviderService } from '../services/walletProvider.service';
import { User, Investor } from '../models';

const walletProviderService = new WalletProviderService();

export const verifyApiKeyOrWalletToken = async (
  req: AuthenticatedRequest,
  res: Response,
  next: NextFunction,
): Promise<void | Response> => {
  try {
    const apiKey = req.get('X-API-Key');
    const authHeader = req.headers.authorization;
    const walletProvider = req.get('X-Wallet-Provider') || 'web3auth'; // Default to Web3Auth
    const token = authHeader?.split(' ')[1];

    // API Key authentication (unchanged)
    if (apiKey && apiKey === env.MASTER_API_KEY) {
      req.isAdmin = true;
      return next();
    }

    // Wallet provider authentication
    if (token) {
      try {
        // Determine user type for provider validation
        const userType = await determineUserType(token, walletProvider);
        
        // Authenticate with the specified provider
        const authResult = await walletProviderService.authenticateWithProvider(
          walletProvider,
          token,
          userType
        );

        if (!authResult.success) {
          throw new Error(authResult.error);
        }

        // Set user information from provider result
        req.user = {
          publicAddress: authResult.user.walletAddress,
          email: authResult.user.email || '',
          provider: walletProvider,
          providerId: authResult.user.providerId,
          walletId: authResult.user.walletId
        };

        // Log wallet provider activity
        await logWalletActivity(req.user, walletProvider, 'login');

        return next();
      } catch (error) {
        logger.error(`${walletProvider} authentication failed:`, error);
        return handleResponse(req, res, error as any, null);
      }
    }

    // No authentication provided
    throw new Error(ERROR_CONSTANTS.UNAUTHORIZED.message);
  } catch (error) {
    return handleResponse(req, res, error as any, null);
  }
};

async function determineUserType(token: string, provider: string): Promise<string> {
  // For Web3Auth, extract user info from JWT
  if (provider === 'web3auth') {
    const { payload } = await jose.jwtVerify(token, JWKS);
    const user = await User.findOne({ email: payload.email }).populate('investorId');
    return user?.investorId?.investorType || 'Retail';
  }
  
  // For other providers, implement provider-specific user lookup
  // This is a simplified version - actual implementation would vary by provider
  return 'Accredited'; // Default for enterprise providers
}

async function logWalletActivity(user: any, provider: string, action: string): Promise<void> {
  try {
    await WalletProviderActivity.create({
      userId: user.userId,
      provider,
      action,
      metadata: {
        walletAddress: user.publicAddress,
        providerId: user.providerId
      },
      success: true
    });
  } catch (error) {
    logger.error('Failed to log wallet activity:', error);
    // Non-critical error, don't fail the authentication
  }
}
```

## Tokenization Platform Frontend Integration

### 1. Accredited Investor Wallet Provider Selection Component

**File**: Tokenization Platform Frontend components (React/TypeScript)

```typescript
// WalletProviderSelector.tsx
interface WalletProviderSelectorProps {
  userType: 'Retail' | 'Accredited' | 'Institutional';
  onProviderSelect: (provider: string) => void;
}

export const WalletProviderSelector: React.FC<WalletProviderSelectorProps> = ({
  userType,
  onProviderSelect
}) => {
  const [availableProviders, setAvailableProviders] = useState<string[]>([]);
  const [selectedProvider, setSelectedProvider] = useState('turnkey'); // Default for tokenization platform

  useEffect(() => {
    // Fetch available providers based on user type
    fetchAvailableProviders(userType).then(setAvailableProviders);
  }, [userType]);

  const providerDetails = {
    // Web3Auth removed from tokenization platform
    turnkey: {
      name: 'Turnkey',
      description: 'High-performance institutional wallet',
      features: ['50-100x faster signing', 'Enterprise security', 'Passkey auth', 'Accredited investor focused'],
      recommended: userType === 'Accredited',
      enterpriseOnly: true,
      requiresAccreditation: true
    },
    dfns: {
      name: 'DFNS',
      description: 'Compliance-focused financial wallet',
      features: ['ERC-3643 compliant', 'Financial institution grade', 'Regulatory ready', 'Full compliance tracking'],
      recommended: userType === 'Institutional',
      enterpriseOnly: true,
      requiresAccreditation: true
    }
  };

  return (
    <div className="wallet-provider-selection">
      <h3>Select Your Wallet Provider</h3>
      
      {availableProviders.map(provider => (
        <div 
          key={provider}
          className={`provider-option ${selectedProvider === provider ? 'selected' : ''}`}
          onClick={() => setSelectedProvider(provider)}
        >
          <div className="provider-header">
            <h4>{providerDetails[provider].name}</h4>
            {providerDetails[provider].recommended && (
              <span className="recommended-badge">Recommended</span>
            )}
            {providerDetails[provider].enterpriseOnly && (
              <span className="enterprise-badge">Enterprise</span>
            )}
          </div>
          
          <p>{providerDetails[provider].description}</p>
          
          <ul>
            {providerDetails[provider].features.map(feature => (
              <li key={feature}>{feature}</li>
            ))}
          </ul>
        </div>
      ))}
      
      <button 
        onClick={() => onProviderSelect(selectedProvider)}
        className="continue-button"
      >
        Continue with {providerDetails[selectedProvider].name}
      </button>
    </div>
  );
};
```

### 2. Provider-Specific Authentication Handlers

```typescript
// walletAuthHandlers.ts
export const walletAuthHandlers = {
  web3auth: async () => {
    // Existing Web3Auth implementation
    return await initializeWeb3Auth();
  },
  
  turnkey: async () => {
    // Turnkey WebAuthn authentication
    const turnkey = await import('@turnkey/sdk-browser');
    return await turnkey.authenticate({
      organizationId: process.env.REACT_APP_TURNKEY_ORG_ID
    });
  },
  
  dfns: async () => {
    // DFNS passkey authentication
    const dfns = await import('@dfns/sdk-browser');
    return await dfns.login({
      orgId: process.env.REACT_APP_DFNS_ORG_ID
    });
  }
};
```

## API Endpoints

### 1. Wallet Provider Management Routes

**File**: `api/routes/walletProvider.routes.ts`

```typescript
import express from 'express';
import { verifyApiKeyOrWalletToken } from '../middleware/verifyApiKeyOrWalletToken.middleware';
import { WalletProviderController } from '../controllers/walletProvider.controller';

const router = express.Router();
const controller = new WalletProviderController();

// Get available providers for user type
router.get(
  '/available-providers',
  verifyApiKeyOrWalletToken,
  controller.getAvailableProviders
);

// Switch wallet provider (accredited/institutional only)
router.post(
  '/switch-provider',
  verifyApiKeyOrWalletToken,
  controller.switchWalletProvider
);

// Create wallet with specific provider
router.post(
  '/create-wallet/:provider',
  verifyApiKeyOrWalletToken,
  controller.createWalletWithProvider
);

// Get wallet provider activity history
router.get(
  '/activity',
  verifyApiKeyOrWalletToken,
  controller.getWalletProviderActivity
);

export default router;
```

