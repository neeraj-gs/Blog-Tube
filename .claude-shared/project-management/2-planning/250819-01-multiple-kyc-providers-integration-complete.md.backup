```javascript
// scripts/run-migration.js - MIGRATION EXECUTION SCRIPT

import { runMigration } from '../migrations/001_add_kyc_provider_fields.js';
import logger from '../api/config/logger.js';

const runKycMigration = async () => {
  try {
    logger.info('Starting KYC provider integration migration...');
    
    // Check environment variables
    const requiredEnvVars = [
      'MONGO_URI',
      'PENOMO_BACKEND'
    ];
    
    const missingVars = requiredEnvVars.filter(varName => !process.env[varName]);
    if (missingVars.length > 0) {
      throw new Error(`Missing required environment variables: ${missingVars.join(', ')}`);
    }
    
    // Run migration
    await runMigration();
    
    logger.info('KYC provider integration migration completed successfully');
    
    // Verify migration
    logger.info('Verifying migration...');
    // Add verification logic here if needed
    
    logger.info('Migration verification completed');
    
  } catch (error) {
    logger.error('Migration failed:', error);
    process.exit(1);
  }
};

// Execute migration
runKycMigration();
