## 15. Security Implementation

### 15.1 Webhook Security Enhancement
```javascript
// api/middleware/webhookSecurity.js - NEW WEBHOOK SECURITY

import crypto from 'crypto';
import logger from '../config/logger.js';
import { handleResponse } from '../responseHandler.js';

export const verifyWebhookSecurity = (expectedOrigins = []) => {
  return async (req, res, next) => {
    try {
      // 1. Rate limiting check (handled by existing middleware)
      
      // 2. Origin verification
      const origin = req.get('Origin') || req.get('Referer');
      if (origin && expectedOrigins.length > 0) {
        const isValidOrigin = expectedOrigins.some(validOrigin => 
          origin.includes(validOrigin)
        );
        
        if (!isValidOrigin) {
          logger.warn('Webhook from invalid origin', {
            origin,
            expectedOrigins,
            ip: req.ip
          });
          return handleResponse(req, res, 'Invalid origin', null);
        }
      }
      
      // 3. Payload size check
      const contentLength = parseInt(req.get('Content-Length') || '0');
      if (contentLength > 1024 * 1024) { // 1MB limit
        logger.warn('Webhook payload too large', {
          contentLength,
          ip: req.ip
        });
        return handleResponse(req, res, 'Payload too large', null);
      }
      
      // 4. Content-Type validation
      const contentType = req.get('Content-Type');
      if (!contentType || !contentType.includes('application/json')) {
        logger.warn('Invalid content type for webhook', {
          contentType,
          ip: req.ip
        });
        return handleResponse(req, res, 'Invalid content type', null);
      }
      
      // 5. Log webhook attempt
      logger.info('Webhook security check passed', {
        provider: req.providerType,
        ip: req.ip,
        userAgent: req.get('User-Agent'),
        contentLength
      });
      
      next();
    } catch (error) {
      logger.error('Webhook security check failed', {
        error: error.message,
        ip: req.ip
      });
      return handleResponse(req, res, 'Security check failed', null);
    }
  };
};

export const sanitizeWebhookPayload = (req, res, next) => {
  try {
    // Basic sanitization of webhook payload
    if (req.body && typeof req.body === 'object') {
      // Remove any potential XSS or injection attempts
      const sanitizeObject = (obj) => {
        if (typeof obj !== 'object' || obj === null) return obj;
        
        const sanitized = {};
        for (const [key, value] of Object.entries(obj)) {
          // Sanitize key
          const cleanKey = key.replace(/[<>'"&]/g, '');
          
          // Sanitize value
          if (typeof value === 'string') {
            sanitized[cleanKey] = value.replace(/[<>'"&]/g, '');
          } else if (typeof value === 'object') {
            sanitized[cleanKey] = sanitizeObject(value);
          } else {
            sanitized[cleanKey] = value;
          }
        }
        return sanitized;
      };
      
      req.body = sanitizeObject(req.body);
    }
    
    next();
  } catch (error) {
    logger.error('Webhook payload sanitization failed', {
      error: error.message
    });
    return handleResponse(req, res, 'Invalid payload format', null);
  }
};
```

