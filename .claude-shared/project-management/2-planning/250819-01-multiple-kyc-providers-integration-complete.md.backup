  priority: {
    type: Number,
    default: 1,
    min: 1,
    max: 10
  },
  
  configuration: {
    baseUrl: String,
    webhookUrl: String,
    supportedDocuments: [String],
    supportedCountries: [String],
    maxRetryAttempts: {
      type: Number,
      default: 3
    }
  },
  
  statistics: {
    totalVerifications: { type: Number, default: 0 },
    successfulVerifications: { type: Number, default: 0 },
    rejectedVerifications: { type: Number, default: 0 },
    averageProcessingTime: { type: Number, default: 0 }, // in minutes
    lastUsed: Date,
    errorRate: { type: Number, default: 0 }
  },
  
  isDeleted: {
    type: Boolean,
    default: false
  }
}, {
  timestamps: true
});

// Indexes for performance
kycProviderSchema.index({ isActive: 1, priority: -1 });
kycProviderSchema.index({ supportedInvestorTypes: 1, isActive: 1 });

export default mongoose.model('KycProvider', kycProviderSchema);
```

## 4. Service Layer Implementation

### 4.1 Base KYC Provider Interface
```javascript
// api/services/providers/base.kyc.provider.js - NEW BASE CLASS

import crypto from 'crypto';
import logger from '../../config/logger.js';

class BaseKycProvider {
  constructor(config) {
    this.config = config;
    this.providerName = this.constructor.name.toLowerCase().replace('service', '');
  }
  
  // Abstract methods - must be implemented by each provider
  async initiateVerification(user, investorData) {
    throw new Error(`initiateVerification must be implemented by ${this.providerName}`);
  }
  
  async parseWebhook(webhookData) {
    throw new Error(`parseWebhook must be implemented by ${this.providerName}`);
  }
  
  async getVerificationStatus(reference) {
    throw new Error(`getVerificationStatus must be implemented by ${this.providerName}`);
  }
  
  async verifyWebhookSignature(payload, signature) {
    throw new Error(`verifyWebhookSignature must be implemented by ${this.providerName}`);
  }
  
  // Common utility methods
  generateReference(userId) {
    const timestamp = Date.now();
    const random = crypto.randomBytes(4).toString('hex');
    return `penomo_${this.providerName}_${userId}_${timestamp}_${random}`;
  }
  
  async makeRequest(endpoint, payload, method = 'POST', customHeaders = {}) {
    try {
      const headers = {
        'Content-Type': 'application/json',
        ...this.getAuthHeaders(),
        ...customHeaders
      };
      
      const requestOptions = {
        method,
        headers
      };
      
      if (payload && (method === 'POST' || method === 'PUT' || method === 'PATCH')) {
        requestOptions.body = JSON.stringify(payload);
      }
      
      logger.info(`${this.providerName} API Request`, {
        endpoint: `${this.config.baseUrl}${endpoint}`,
        method,
        hasPayload: !!payload
      });
      
      const response = await fetch(`${this.config.baseUrl}${endpoint}`, requestOptions);
      
      if (!response.ok) {
        const errorText = await response.text();
        logger.error(`${this.providerName} API Error`, {
          status: response.status,
          statusText: response.statusText,
          error: errorText
        });
        throw new Error(`${this.providerName} API error: ${response.status} ${response.statusText}`);
      }
      
      const result = await response.json();
      logger.info(`${this.providerName} API Response`, { success: true });
      
      return result;
    } catch (error) {
      logger.error(`${this.providerName} API Request Failed`, {
        error: error.message,
        endpoint,
        method
      });
      throw error;
    }
  }
  
  getAuthHeaders() {
    throw new Error(`getAuthHeaders must be implemented by ${this.providerName}`);
  }
  
  // Status mapping to unified format
  mapStatusToUnified(providerStatus) {
    const statusMap = this.getStatusMapping();
    return statusMap[providerStatus] || 'Unknown';
  }
  
  getStatusMapping() {
    throw new Error(`getStatusMapping must be implemented by ${this.providerName}`);
  }
  
  // Error handling utilities
  handleProviderError(error, operation) {
    logger.error(`${this.providerName} ${operation} Error`, {
      error: error.message,
      stack: error.stack,
      provider: this.providerName
    });
    
    return {
      success: false,
      provider: this.providerName,
      operation,
      error: error.message,
      timestamp: new Date().toISOString()
    };
  }
}

export default BaseKycProvider;
```

### 4.2 Enhanced GetSilt Provider Service
```javascript
// api/services/providers/getsilt.service.js - EXTRACT FROM EXISTING

import BaseKycProvider from './base.kyc.provider.js';
import logger from '../../config/logger.js';
import { GETSILT_API_KEY, GETSILT_BASE_URL } from '../../constants/env_var.js';

class GetSiltService extends BaseKycProvider {
  constructor() {
    super({
      baseUrl: GETSILT_BASE_URL,
      apiKey: GETSILT_API_KEY
    });
  }
  
  async initiateVerification(user, investorData) {
    try {
      const reference = this.generateReference(user._id);
      
      // GetSilt verification payload (based on existing implementation)
      const payload = {
        user_id: user._id.toString(),
        email: user.email,
        first_name: user.firstName || '',
        last_name: user.lastName || '',
        country: user.countryOfResidence || 'US',
        reference,
        callback_url: `${process.env.PENOMO_BACKEND}/api/kyc/webhook/getsilt`
      };
      
      logger.info('GetSilt verification initiated', {
        userId: user._id,
        reference,
        email: user.email
      });
      
      // Make API call to GetSilt
      const result = await this.makeRequest('/verification/initiate', payload);
      
      return {
        provider: 'getsilt',
        reference,
        verificationUrl: result.verification_url,
        providerId: result.verification_id,
        status: 'Initiated'
      };
    } catch (error) {
      return this.handleProviderError(error, 'initiate_verification');
    }
  }
  
  async parseWebhook(webhookData) {
    try {
      // Parse GetSilt webhook format (based on existing handleSiltWebhookService)
      const {
        processing_attempt,
        user_id,
        notification_id,
        user
      } = webhookData;
      
      const status = user?.status;
      const manual_review_status = user?.manual_review_status;
      
      let unifiedStatus;
      let reason = null;
      
      if (status === 'SUCCESS' || manual_review_status === 'SUCCESS') {
        unifiedStatus = 'Verified';
      } else if (status === 'ERROR' && manual_review_status !== 'PENDING') {
        unifiedStatus = 'Rejected';
        reason = 'KYC verification failed';
      } else if ((status === 'VERIFICATION_ERROR' || status === 'ERROR') && 
                 manual_review_status === 'PENDING') {
        unifiedStatus = 'Pending';
        reason = 'Under manual review';
      } else {
        unifiedStatus = 'Unknown';
      }
      
      return {
        userId: user_id,
        provider: 'getsilt',
        status: unifiedStatus,
        providerId: notification_id,
        reference: webhookData.reference,
        reason,
        documents: this.extractDocuments(webhookData),
        personalInfo: {
          firstName: user?.first_name,
          lastName: user?.last_name,
          country: user?.country
        },
        metadata: {
          processing_attempt,
          manual_review_status
        }
      };
    } catch (error) {
      logger.error('GetSilt webhook parsing failed', {
        error: error.message,
        webhookData
      });
      throw error;
    }
  }
  
  async verifyWebhookSignature(payload, signature) {
    // Implement GetSilt signature verification if available
    // For now, return true as existing implementation doesn't verify
    return true;
  }
  
  getAuthHeaders() {
    return {
      'Authorization': `Bearer ${this.config.apiKey}`,
      'X-API-Key': this.config.apiKey
    };
  }
  
  getStatusMapping() {
    return {
      'SUCCESS': 'Verified',
      'ERROR': 'Rejected',
      'PENDING': 'Pending',
      'VERIFICATION_ERROR': 'Pending'
    };
  }
  
  extractDocuments(webhookData) {
    const documents = [];
    
    if (webhookData.user?.passport) {
      documents.push({
        type: 'passport',
        number: webhookData.user.passport.document_number
      });
    }
    
    if (webhookData.user?.verifications) {
      webhookData.user.verifications.forEach(verification => {
        if (verification.data?.number) {
          documents.push({
            type: verification.type || 'unknown',
            number: verification.data.number
          });
        }
      });
    }
    
    return documents;
  }
}

export default GetSiltService;
```

### 4.3 Complete Shufti Pro Provider Service
```javascript
// api/services/providers/shufti.service.js - NEW SHUFTI IMPLEMENTATION

import crypto from 'crypto';
import BaseKycProvider from './base.kyc.provider.js';
import logger from '../../config/logger.js';
import { 
  SHUFTI_CLIENT_ID, 
  SHUFTI_SECRET_KEY, 
  SHUFTI_BASE_URL, 
  SHUFTI_WEBHOOK_URL 
} from '../../constants/env_var.js';

class ShuftiService extends BaseKycProvider {
  constructor() {
    super({
      baseUrl: SHUFTI_BASE_URL || 'https://api.shuftipro.com',
      clientId: SHUFTI_CLIENT_ID,
      secretKey: SHUFTI_SECRET_KEY
    });
  }
  
  async initiateVerification(user, investorData) {
    try {
      const reference = this.generateReference(user._id);
      
      // Shufti Pro verification payload (based on documentation analysis)
      const payload = {
        reference,
        callback_url: `${SHUFTI_WEBHOOK_URL}/webhook/shufti`,
        email: user.email,
        country: user.countryOfResidence || 'US',
        language: 'EN',
        verification_mode: 'any',
        show_results: 0, // Async response
        
        // Face verification
        face: {},
        
        // Document verification for accredited investors
        document: {
          proof: ['passport', 'id_card', 'driving_license'],
          additional_proof: ['utility_bill'],
          name: {
            first_name: user.firstName || '',
            last_name: user.lastName || ''
          },
          dob: investorData.dateOfBirth || null,
          document_type: ['passport', 'id_card'],
          country: user.countryOfResidence || 'US'
        },
        
        // Address verification (required for accredited investors)
        address: {
          proof: ['utility_bill', 'bank_statement'],
          name: {
            first_name: user.firstName || '',
            last_name: user.lastName || ''
          },
          country: user.countryOfResidence || 'US'
        }
      };
      
      logger.info('Shufti Pro verification initiated', {
        userId: user._id,
        reference,
        email: user.email,
        investorType: investorData.investorType
      });
      
      const result = await this.makeRequest('/', payload);
      
      return {
        provider: 'shufti',
        reference,
        verificationUrl: result.verification_url,
        providerId: result.verification_id,
        status: 'Initiated',
        metadata: {
          event: result.event,
          verification_id: result.verification_id
        }
      };
    } catch (error) {
      return this.handleProviderError(error, 'initiate_verification');
    }
  }
  
  async parseWebhook(webhookData) {
    try {
      // Parse Shufti Pro webhook format
      const {
        reference,
        event,
        verification_id,
        verification_data,
        decline_reason,
        verification_result
      } = webhookData;
      
      // Extract user ID from reference
      const userId = this.extractUserIdFromReference(reference);
      
      let unifiedStatus;
      let reason = null;
      
      switch (event) {
        case 'verification.accepted':
          unifiedStatus = 'Verified';
          break;
        case 'verification.declined':
          unifiedStatus = 'Rejected';
          reason = decline_reason || 'Verification failed';
          break;
        case 'verification.pending':
          unifiedStatus = 'Pending';
          reason = 'Under review';
          break;
        case 'verification.cancelled':
          unifiedStatus = 'Cancelled';
          reason = 'User cancelled verification';
          break;
        case 'request.received':
          unifiedStatus = 'Pending';
          reason = 'Request received';
          break;
        default:
          unifiedStatus = 'Unknown';
          reason = `Unknown event: ${event}`;
      }
      
      return {
        userId,
        provider: 'shufti',
        status: unifiedStatus,
        providerId: verification_id,
        reference,
        reason,
        documents: this.extractShuftiDocuments(verification_data),
        personalInfo: this.extractPersonalInfo(verification_data),
        metadata: {
          event,
          verification_result,
          decline_reason
        }
      };
    } catch (error) {
      logger.error('Shufti webhook parsing failed', {
        error: error.message,
        webhookData
      });
      throw error;
    }
  }
  
  async verifyWebhookSignature(payload, signature) {
    try {
      // Shufti Pro signature verification process
      // 1. Take SHA256 of the Secret Key
      const hashedSecretKey = crypto
        .createHash('sha256')
        .update(this.config.secretKey)
        .digest('hex');
      
      // 2. Concatenate hashed Secret Key to raw response string
      const rawPayload = JSON.stringify(payload);
      const concatenated = rawPayload + hashedSecretKey;
      
      // 3. Take SHA256 of concatenated string
      const expectedSignature = crypto
        .createHash('sha256')
        .update(concatenated)
        .digest('hex');
      
      // 4. Compare with received signature
      return crypto.timingSafeEqual(
        Buffer.from(signature),
        Buffer.from(expectedSignature)
      );
    } catch (error) {
      logger.error('Shufti signature verification failed', {
        error: error.message
      });
      return false;
    }
  }
  
  getAuthHeaders() {
    const credentials = Buffer.from(
      `${this.config.clientId}:${this.config.secretKey}`
    ).toString('base64');
    
    return {
      'Authorization': `Basic ${credentials}`,
      'Content-Type': 'application/json'
    };
  }
  
  getStatusMapping() {
    return {
      'verification.accepted': 'Verified',
      'verification.declined': 'Rejected',
      'verification.pending': 'Pending',
      'verification.cancelled': 'Cancelled',
      'request.received': 'Pending'
    };
  }
  
  extractUserIdFromReference(reference) {
    // Extract user ID from generated reference
    // Format: penomo_shufti_{userId}_{timestamp}_{random}
    const parts = reference.split('_');
    if (parts.length >= 3) {
      return parts[2];
    }
    throw new Error(`Invalid reference format: ${reference}`);
  }
  
  extractShuftiDocuments(verificationData) {
    if (!verificationData) return [];
    
    const documents = [];
    
    if (verificationData.document) {
      documents.push({
        type: 'identity_document',
        status: verificationData.document.status,
        number: verificationData.document.document_number
      });
    }
    
    if (verificationData.address) {
      documents.push({
        type: 'address_proof',
        status: verificationData.address.status
      });
    }
    
    if (verificationData.face) {
      documents.push({
        type: 'face_verification',
        status: verificationData.face.status
      });
    }
    
    return documents;
  }
  
  extractPersonalInfo(verificationData) {
    if (!verificationData?.document) return {};
    
    return {
      firstName: verificationData.document.first_name,
      lastName: verificationData.document.last_name,
      fullName: verificationData.document.full_name,
      dateOfBirth: verificationData.document.dob,
      country: verificationData.document.country,
      documentNumber: verificationData.document.document_number
    };
  }
}

export default ShuftiService;
```

### 4.4 KYC Manager Service (Orchestrator)
```javascript
// api/services/kycManager.service.js - NEW ORCHESTRATION SERVICE

import logger from '../config/logger.js';
import User from '../models/users.model.js';
import Investor from '../models/investor.model.js';
import KycProvider from '../models/kycProvider.model.js';
import GetSiltService from './providers/getsilt.service.js';
import ShuftiService from './providers/shufti.service.js';
import { createNotification } from './notification.service.js';
import { handleKycReferralRewardService } from './referral.service.js';
import { NOTIFICATION_MESSAGES } from '../constants/servicesDynamicContent.js';

class KycManagerService {
  constructor() {
    this.providers = {
      getsilt: new GetSiltService(),
      shufti: new ShuftiService()
    };
  }
  
  async getProviderForUser(userId) {
    try {
      const user = await User.findById(userId).populate('investorId');
      if (!user) {
        throw new Error('User not found');
      }
      
      if (!user.investorId) {
        throw new Error('User has no investor profile');
      }
      
      const investorType = user.investorId.investorType;
      const providerType = await this.getProviderByInvestorType(investorType);
      
      const provider = this.providers[providerType];
      if (!provider) {
        throw new Error(`Provider ${providerType} not available`);
      }
      
      return {
        provider,
        providerType,
        user,
        investor: user.investorId
      };
    } catch (error) {
      logger.error('Error getting provider for user', {
        userId,
        error: error.message
      });
      throw error;
    }
  }
  
  async getProviderByInvestorType(investorType) {
    try {
      // Check database configuration first
      const dbProvider = await KycProvider.findOne({
        supportedInvestorTypes: investorType,
        isActive: true
      }).sort({ priority: -1 });
      
      if (dbProvider) {
        return dbProvider.name;
      }
      
      // Fallback to hardcoded mapping
      const defaultMapping = {
        'Retail': 'getsilt',
        'Accredited': 'sumsub',  // UPDATED: Use Sumsub for tokenization platform
        'Institutional': 'sumsub' // UPDATED: Use Sumsub for tokenization platform
      };
      
      const provider = defaultMapping[investorType];
      if (!provider) {
        throw new Error(`No KYC provider configured for investor type: ${investorType}`);
      }
      
      return provider;
    } catch (error) {
      logger.error('Error determining provider for investor type', {
        investorType,
        error: error.message
      });
      throw error;
    }
  }
  
  async initiateVerification(userId) {
    try {
      const { provider, providerType, user, investor } = await this.getProviderForUser(userId);
      
      logger.info('Initiating KYC verification', {
        userId,
        providerType,
        investorType: investor.investorType,
        email: user.email
      });
      
      // Update user record with provider info
      user.kycProvider = providerType;
      user.kycStatus = 'Pending';
      
      // Add attempt record
      user.kycAttempts.push({
        provider: providerType,
        attemptDate: new Date(),
        status: 'Initiated',
        reason: 'User initiated verification'
      });
      
      await user.save();
      
      // Initiate verification with selected provider
      const result = await provider.initiateVerification(user, investor);
      
      if (result.success === false) {
        throw new Error(result.error || 'Provider verification initiation failed');
      }
      
      // Update attempt with result
      const lastAttempt = user.kycAttempts[user.kycAttempts.length - 1];
      lastAttempt.reference = result.reference;
      lastAttempt.metadata = result.metadata;
      await user.save();
      
      // Update provider statistics
      await this.updateProviderStats(providerType, 'initiated');
      
      logger.info('KYC verification initiated successfully', {
        userId,
        provider: providerType,
        reference: result.reference
      });
      
      return {
        success: true,
        provider: providerType,
        verificationUrl: result.verificationUrl,
        reference: result.reference,
        providerId: result.providerId
      };
    } catch (error) {
      logger.error('Error initiating KYC verification', {
        userId,
        error: error.message
      });
      throw error;
    }
  }
  
  async processWebhook(providerType, webhookData, signature, io) {
    try {
      const provider = this.providers[providerType];
      if (!provider) {
        throw new Error(`Unknown KYC provider: ${providerType}`);
      }
      
      logger.info('Processing KYC webhook', {
        provider: providerType,
        hasSignature: !!signature
      });
      
      // Verify webhook signature
      if (signature) {
        const isValid = await provider.verifyWebhookSignature(webhookData, signature);
        if (!isValid) {
          throw new Error('Invalid webhook signature');
        }
      }
      
      // Parse webhook data to unified format
      const unifiedData = await provider.parseWebhook(webhookData);
      
      // Process the unified KYC update
      const result = await this.processUnifiedKycUpdate(unifiedData, io);
      
      logger.info('KYC webhook processed successfully', {
        provider: providerType,
        userId: unifiedData.userId,
        status: unifiedData.status
      });
      
      return result;
    } catch (error) {
      logger.error('Error processing KYC webhook', {
        provider: providerType,
        error: error.message
      });
      throw error;
    }
  }
  
  async processUnifiedKycUpdate(data, io) {
    try {
      const { userId, status, provider, providerId, reference, reason, documents, personalInfo, metadata } = data;
      
      const user = await User.findById(userId);
      if (!user) {
        throw new Error('User not found');
      }
      
      logger.info('Processing unified KYC update', {
        userId,
        oldStatus: user.kycStatus,
        newStatus: status,
        provider
      });
      
      // Update user KYC status
      const oldStatus = user.kycStatus;
      user.kycStatus = status;
      user.kycProvider = provider;
      user.kycProviderUserId = providerId;
      
      if (status === 'Verified') {
        user.isKycVerified = true;
        user.kycVerificationDate = new Date();
        user.kycRejectionReason = null;
      } else if (status === 'Rejected') {
        user.isKycVerified = false;
        user.kycRejectionReason = reason;
      }
      
      // Update personal info if provided
      if (personalInfo) {
        if (personalInfo.firstName) user.firstName = personalInfo.firstName;
        if (personalInfo.lastName) user.lastName = personalInfo.lastName;
        if (personalInfo.country) user.countryOfResidence = personalInfo.country;
      }
      
      // Add attempt record
      user.kycAttempts.push({
        provider,
        attemptDate: new Date(),
        status,
        reason: reason || `KYC ${status.toLowerCase()}`,
        reference,
        metadata
      });
      
      await user.save();
      
      // Update provider statistics
      await this.updateProviderStats(provider, status.toLowerCase());
      
      // Create notification
      await this.createKycNotification(user, status, reason);
      
      // Emit socket event
      if (io) {
        io.emit(`kyc_status_${userId}`, {
          userId,
          status,
          provider,
          oldStatus,
          documents: documents || [],
          timestamp: new Date().toISOString()
        });
      }
      
      // Handle post-verification actions
      if (status === 'Verified') {
        await this.handlePostVerificationActions(user);
      }
      
      return { 
        success: true, 
        status, 
        provider,
        oldStatus,
        newStatus: status,
        userId
      };
    } catch (error) {
      logger.error('Error processing unified KYC update', {
        userId: data.userId,
        error: error.message
      });
      throw error;
    }
  }
  
  async createKycNotification(user, status, reason) {
    try {
      let notificationMessage;
      let emailMessage;
      
      switch (status) {
        case 'Verified':
          notificationMessage = NOTIFICATION_MESSAGES.KYC_VERIFIED;
          emailMessage = 'Congratulations! Your KYC has been successfully completed. Please go back to the Penomo app.';
          break;
        case 'Rejected':
          notificationMessage = reason || NOTIFICATION_MESSAGES.KYC_REJECTED;
          emailMessage = `We regret to inform you that your KYC verification has failed. Reason: ${reason || 'Please try again and only use your Passport or National ID.'}`;
          break;
        case 'Pending':
          notificationMessage = NOTIFICATION_MESSAGES.KYC_PENDING;
          emailMessage = 'Your KYC verification is under review. We will notify you as soon as it is completed.';
          break;
        default:
          return; // Don't create notification for unknown status
      }
      
      await createNotification(
        'USER',
        user._id,
        'KYC Status Update',
        notificationMessage,
        'No actions needed',
        emailMessage
      );
    } catch (error) {
      logger.error('Error creating KYC notification', {
        userId: user._id,
        status,
        error: error.message
      });
      // Don't throw - notification failure shouldn't fail the main process
    }
  }
  
  async handlePostVerificationActions(user) {
    try {
      // Handle referral rewards
      await handleKycReferralRewardService(user);
      
      logger.info('Post-verification actions completed', {
        userId: user._id
      });
    } catch (error) {
      logger.error('Error in post-verification actions', {
        userId: user._id,
        error: error.message
      });
      // Don't throw - these are nice-to-have actions
    }
  }
  
  async updateProviderStats(providerName, operation) {
    try {
      let updateQuery = {};
      
      switch (operation) {
        case 'initiated':
          updateQuery = {
            $inc: { 'statistics.totalVerifications': 1 },
            $set: { 'statistics.lastUsed': new Date() }
          };
          break;
        case 'verified':
          updateQuery = {
            $inc: { 'statistics.successfulVerifications': 1 }
          };
          break;
        case 'rejected':
          updateQuery = {
            $inc: { 'statistics.rejectedVerifications': 1 }
          };
          break;
      }
      
      if (Object.keys(updateQuery).length > 0) {
        await KycProvider.findOneAndUpdate(
          { name: providerName },
          updateQuery,
          { upsert: true }
        );
      }
    } catch (error) {
      logger.error('Error updating provider statistics', {
        providerName,
        operation,
        error: error.message
      });
      // Don't throw - stats update failure shouldn't fail main process
    }
  }
  
  async getProviderStats() {
    try {
      return await KycProvider.find({ isActive: true }).sort({ priority: -1 });
    } catch (error) {
      logger.error('Error getting provider stats', { error: error.message });
      return [];
    }
  }
}

export default new KycManagerService();
```

## 5. Controllers Implementation

### 5.1 Enhanced KYC Controller
```javascript
// api/controllers/kyc.controller.js - ENHANCED WITH NEW METHODS

import logger from '../config/logger.js';
import { WEBHOOK_MESSAGES } from '../constants/servicesDynamicContent.js';
import {
  getPendingKycService,
  handleSiltWebhookService, // Keep existing for backward compatibility
  verifyUserKycService,
  verifyCompanyKybService,
  verifyInvestorKybService,
} from '../services/kyc.service.js';
import kycManagerService from '../services/kycManager.service.js';
import {
  handleResponseWithMessage,
  handleResponse,
} from '../responseHandler.js';

// Keep existing controllers for backward compatibility
export const getPendingKycController = async (req, res) => {
  try {
    const pendingUsers = await getPendingKycService();

    return handleResponseWithMessage(
      req,
      res,
      null,
      'List of users who have not yet completed kyc',
      pendingUsers,
      200,
    );
  } catch (error) {
    logger.error('Error fetching pending users:', error);
    return handleResponse(req, res, error, null);
  }
};

// Legacy GetSilt webhook handler - KEEP FOR BACKWARD COMPATIBILITY
export const handleSiltWebhookController = async (req, res) => {
  try {
    const io = req.app.locals.io;
    const result = await handleSiltWebhookService(req.body, io);
    
    logger.info('Legacy GetSilt webhook processed:', result);

    return handleResponseWithMessage(
      req,
      res,
      null,
      WEBHOOK_MESSAGES.PROCESSED,
      result,
      200,
    );
  } catch (error) {
    logger.error('Error in legacy GetSilt webhook handler:', error.message);
    return handleResponse(req, res, error, null);
  }
};

// NEW UNIFIED CONTROLLERS

export const handleUnifiedKycWebhookController = async (req, res) => {
  try {
    const io = req.app.locals.io;
    
    // Determine provider type from route or header
    const providerType = req.providerType || 
                        req.path.includes('getsilt') ? 'getsilt' : 
                        req.path.includes('shufti') ? 'shufti' : 
                        req.headers['x-provider-type'] || 'unknown';
    
    if (providerType === 'unknown') {
      logger.error('Unknown provider type in webhook request', {
        path: req.path,
        headers: req.headers
      });
      return handleResponse(req, res, 'Unknown provider type', null);
    }
    
    // Extract signature for verification
    const signature = req.headers['x-signature'] || 
                     req.headers['signature'] || 
                     req.headers['x-webhook-signature'];
    
    logger.info('Processing unified KYC webhook', {
      provider: providerType,
      hasSignature: !!signature,
      path: req.path
    });
    
    const result = await kycManagerService.processWebhook(
      providerType, 
      req.body, 
      signature, 
      io
    );
    
    return handleResponseWithMessage(
      req,
      res,
      null,
      'Webhook processed successfully',
      result,
      200
    );
  } catch (error) {
    logger.error('Error processing unified KYC webhook:', error.message);
    return handleResponse(req, res, error, null);
  }
};

export const initiateKycVerificationController = async (req, res) => {
  try {
    const { userId } = req.params;
    
    // Validate user access (only admin or the user themselves)
    if (req.user.role !== 'admin' && req.user.userId !== userId) {
      return handleResponse(req, res, 'Unauthorized access', null);
    }
    
    logger.info('Initiating KYC verification', {
      userId,
      requestedBy: req.user.userId,
      requestedByRole: req.user.role
    });
    
    const result = await kycManagerService.initiateVerification(userId);
    
    return handleResponseWithMessage(
      req,
      res,
      null,
      'KYC verification initiated successfully',
      result,
      200
    );
  } catch (error) {
    logger.error('Error initiating KYC verification:', error.message);
    return handleResponse(req, res, error, null);
  }
};

export const getKycStatusController = async (req, res) => {
  try {
    const { userId } = req.params;
    
    // Validate user access (only admin or the user themselves)
    if (req.user.role !== 'admin' && req.user.userId !== userId) {
      return handleResponse(req, res, 'Unauthorized access', null);
    }
    
    // Get user with KYC details
    const user = await User.findById(userId)
      .select('kycStatus kycProvider kycProviderUserId kycAttempts kycVerificationDate kycRejectionReason')
      .populate('investorId', 'investorType');
    
    if (!user) {
      return handleResponse(req, res, 'User not found', null);
    }
    
    const response = {
      userId,
      kycStatus: user.kycStatus,
      provider: user.kycProvider,
      providerUserId: user.kycProviderUserId,
      verificationDate: user.kycVerificationDate,
      rejectionReason: user.kycRejectionReason,
      investorType: user.investorId?.investorType,
      attempts: user.kycAttempts?.length || 0,
      lastAttempt: user.kycAttempts?.length > 0 ? 
        user.kycAttempts[user.kycAttempts.length - 1] : null
    };
    
    return handleResponseWithMessage(
      req,
      res,
      null,
      'KYC status retrieved successfully',
      response,
      200
    );
  } catch (error) {
    logger.error('Error getting KYC status:', error.message);
    return handleResponse(req, res, error, null);
  }
};

export const getKycProvidersController = async (req, res) => {
  try {
    // Only admin can view provider information
    if (req.user.role !== 'admin') {
      return handleResponse(req, res, 'Unauthorized access', null);
    }
    
    const providers = await kycManagerService.getProviderStats();
    
    return handleResponseWithMessage(
      req,
      res,
      null,
      'KYC providers retrieved successfully',
      providers,
      200
    );
  } catch (error) {
    logger.error('Error getting KYC providers:', error.message);
    return handleResponse(req, res, error, null);
  }
};

// Keep existing controllers unchanged
export const verifyUserKycController = async (req, res) => {
