## 6. Routes Implementation

### 6.1 New Unified KYC Routes
```javascript
// api/routes/kyc.routes.js - NEW DEDICATED KYC ROUTES

import express from 'express';
import { dynamicRateLimiter } from '../middleware/dynamicRateLimiter.js';
import {
  verifyJwtToken,
  verifyHeaderApiKey,
  allowedRoles,
} from '../middleware/verifyApiKeyOrToken.js';
import {
  handleUnifiedKycWebhookController,
  initiateKycVerificationController,
  getKycStatusController,
  getKycProvidersController,
} from '../controllers/kyc.controller.js';
import {
  validateKycInitiation,
  validateKycStatus,
  validateWebhookProvider,
} from '../validator/kyc.validator.js';

const router = express.Router();

// Unified webhook endpoint (provider-agnostic)
router.post(
  '/webhook/unified',
  validateWebhookProvider,
  dynamicRateLimiter('kyc_webhook_unified'),
  handleUnifiedKycWebhookController
);

// Provider-specific webhook endpoints
router.post(
  '/webhook/getsilt',
  (req, res, next) => {
    req.providerType = 'getsilt';
    next();
  },
  dynamicRateLimiter('kyc_webhook_getsilt'),
  handleUnifiedKycWebhookController
);

router.post(
  '/webhook/shufti',
  (req, res, next) => {
    req.providerType = 'shufti';
    next();
  },
  dynamicRateLimiter('kyc_webhook_shufti'),
  handleUnifiedKycWebhookController
);

// KYC initiation endpoint
router.post(
  '/initiate/:userId',
  verifyJwtToken,
  validateKycInitiation,
  allowedRoles(['admin', 'investor', 'issuer']),
  dynamicRateLimiter('kyc_initiate'),
  initiateKycVerificationController
);

// KYC status check
router.get(
  '/status/:userId',
  verifyJwtToken,
  validateKycStatus,
  allowedRoles(['admin', 'investor', 'issuer']),
  dynamicRateLimiter('kyc_status_check'),
  getKycStatusController
);

// Provider management (admin only)
router.get(
  '/providers',
  verifyJwtToken,
  allowedRoles(['admin']),
  dynamicRateLimiter('kyc_providers_list'),
  getKycProvidersController
);

export default router;
```

