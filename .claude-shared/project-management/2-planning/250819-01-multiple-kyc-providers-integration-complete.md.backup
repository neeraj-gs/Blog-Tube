      duration: 60 * 5,
    },
    kyc_service: {
      points: 2000,
      duration: 60 * 5,
    },
  },

  kyc_webhook_shufti: {
    guest: {
      points: 500,
      duration: 60 * 5,
    },
    kyc_service: {
      points: 2000,
      duration: 60 * 5,
    },
  },

  // User-initiated operations - moderate limits
  kyc_initiate: {
    investor: {
      points: 10, // 10 attempts per hour (reasonable for KYC)
      duration: 60 * 60,
    },
    issuer: {
      points: 10,
      duration: 60 * 60,
    },
    admin: {
      points: 100,
      duration: 60 * 60,
    },
  },

  // Status checks - higher limits
  kyc_status_check: {
    investor: {
      points: 100,
      duration: 60 * 10,
    },
    issuer: {
      points: 100,
      duration: 60 * 10,
    },
    admin: {
      points: 1000,
      duration: 60 * 10,
    },
  },

  // Provider management - admin only, low limits
  kyc_providers_list: {
    admin: {
      points: 50,
      duration: 60 * 10,
    },
  },
};
```

## 10. Testing Implementation

### 10.1 KYC Manager Service Tests
```javascript
// __tests__/services/kycManager.service.test.js - NEW COMPREHENSIVE TESTS

import mongoose from 'mongoose';
import kycManagerService from '../../services/kycManager.service.js';
import User from '../../models/users.model.js';
import Investor from '../../models/investor.model.js';
import KycProvider from '../../models/kycProvider.model.js';
import GetSiltService from '../../services/providers/getsilt.service.js';
import ShuftiService from '../../services/providers/shufti.service.js';

// Mock dependencies
jest.mock('../../services/providers/getsilt.service.js');
jest.mock('../../services/providers/shufti.service.js');
jest.mock('../../services/notification.service.js');
jest.mock('../../services/referral.service.js');

describe('KycManagerService', () => {
  beforeEach(async () => {
    // Clear all mocks
    jest.clearAllMocks();
    
    // Clear database
    await User.deleteMany({});
    await Investor.deleteMany({});
    await KycProvider.deleteMany({});
  });

  describe('getProviderForUser', () => {
    it('should return GetSilt for retail investors', async () => {
      // Arrange
      const investor = await Investor.create({
        investorType: 'Retail',
        financialKnowledge: 'Basic'
      });
      
      const user = await User.create({
        email: 'retail@test.com',
        firstName: 'Retail',
        lastName: 'Investor',
        investorId: investor._id,
        kycStatus: 'Not Submitted'
      });

      // Act
      const result = await kycManagerService.getProviderForUser(user._id);

      // Assert
      expect(result.providerType).toBe('getsilt');
      expect(result.provider).toBeInstanceOf(GetSiltService);
      expect(result.user._id.toString()).toBe(user._id.toString());
      expect(result.investor.investorType).toBe('Retail');
    });

    it('should return Shufti for accredited investors', async () => {
      // Arrange
      const investor = await Investor.create({
        investorType: 'Accredited',
        financialKnowledge: 'Advanced',
        isVerifiedAccredited: true
      });
      
      const user = await User.create({
        email: 'accredited@test.com',
        firstName: 'Accredited',
        lastName: 'Investor',
        investorId: investor._id,
        kycStatus: 'Not Submitted'
      });

      // Act
      const result = await kycManagerService.getProviderForUser(user._id);

      // Assert
      expect(result.providerType).toBe('shufti');
      expect(result.provider).toBeInstanceOf(ShuftiService);
      expect(result.investor.investorType).toBe('Accredited');
    });

    it('should throw error for user without investor profile', async () => {
      // Arrange
      const user = await User.create({
        email: 'noinvestor@test.com',
        firstName: 'No',
        lastName: 'Investor',
        kycStatus: 'Not Submitted'
      });

      // Act & Assert
      await expect(kycManagerService.getProviderForUser(user._id))
        .rejects.toThrow('User has no investor profile');
    });

    it('should use database provider configuration when available', async () => {
      // Arrange
      await KycProvider.create({
        name: 'shufti',
        displayName: 'Shufti Pro',
        isActive: true,
        supportedInvestorTypes: ['Retail'],
        priority: 10 // Higher than default
      });

      const investor = await Investor.create({
        investorType: 'Retail',
        financialKnowledge: 'Basic'
      });
      
      const user = await User.create({
        email: 'retail@test.com',
        firstName: 'Retail',
        lastName: 'Investor',
        investorId: investor._id
      });

      // Act
      const result = await kycManagerService.getProviderForUser(user._id);

      // Assert
      expect(result.providerType).toBe('shufti'); // Should use DB config, not default
    });
  });

  describe('initiateVerification', () => {
    it('should successfully initiate verification with GetSilt', async () => {
      // Arrange
      const investor = await Investor.create({
        investorType: 'Retail'
      });
      
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        investorId: investor._id,
        kycStatus: 'Not Submitted'
      });

      const mockResult = {
        provider: 'getsilt',
        reference: 'test_ref_123',
        verificationUrl: 'https://getsilt.com/verify/123',
        providerId: 'getsilt_123',
        status: 'Initiated'
      };

      GetSiltService.prototype.initiateVerification = jest.fn().mockResolvedValue(mockResult);

      // Act
      const result = await kycManagerService.initiateVerification(user._id);

      // Assert
      expect(result.success).toBe(true);
      expect(result.provider).toBe('getsilt');
      expect(result.reference).toBe('test_ref_123');
      expect(GetSiltService.prototype.initiateVerification).toHaveBeenCalledWith(
        expect.objectContaining({ email: 'test@example.com' }),
        expect.objectContaining({ investorType: 'Retail' })
      );

      // Check user was updated
      const updatedUser = await User.findById(user._id);
      expect(updatedUser.kycStatus).toBe('Pending');
      expect(updatedUser.kycProvider).toBe('getsilt');
      expect(updatedUser.kycAttempts).toHaveLength(1);
      expect(updatedUser.kycAttempts[0].status).toBe('Initiated');
    });

    it('should handle provider initiation failure', async () => {
      // Arrange
      const investor = await Investor.create({
        investorType: 'Retail'
      });
      
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        investorId: investor._id
      });

      GetSiltService.prototype.initiateVerification = jest.fn().mockResolvedValue({
        success: false,
        error: 'Provider API error'
      });

      // Act & Assert
      await expect(kycManagerService.initiateVerification(user._id))
        .rejects.toThrow('Provider API error');
    });
  });

  describe('processWebhook', () => {
    it('should process GetSilt webhook correctly', async () => {
      // Arrange
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        kycStatus: 'Pending',
        kycProvider: 'getsilt'
      });

      const mockWebhookData = {
        user_id: user._id.toString(),
        notification_id: 'notif_123',
        user: {
          status: 'SUCCESS',
          first_name: 'Test',
          last_name: 'User',
          country: 'US'
        }
      };

      const mockParsedData = {
        userId: user._id.toString(),
        provider: 'getsilt',
        status: 'Verified',
        providerId: 'notif_123',
        personalInfo: {
          firstName: 'Test',
          lastName: 'User',
          country: 'US'
        }
      };

      GetSiltService.prototype.verifyWebhookSignature = jest.fn().mockResolvedValue(true);
      GetSiltService.prototype.parseWebhook = jest.fn().mockResolvedValue(mockParsedData);

      const mockIo = {
        emit: jest.fn()
      };

      // Act
      const result = await kycManagerService.processWebhook(
        'getsilt', 
        mockWebhookData, 
        'signature_123', 
        mockIo
      );

      // Assert
      expect(result.success).toBe(true);
      expect(result.status).toBe('Verified');
      expect(result.provider).toBe('getsilt');

      // Verify webhook signature was checked
      expect(GetSiltService.prototype.verifyWebhookSignature)
        .toHaveBeenCalledWith(mockWebhookData, 'signature_123');

      // Verify webhook was parsed
      expect(GetSiltService.prototype.parseWebhook)
        .toHaveBeenCalledWith(mockWebhookData);

      // Verify socket event was emitted
      expect(mockIo.emit).toHaveBeenCalledWith(
        `kyc_status_${user._id}`,
        expect.objectContaining({
          status: 'Verified',
          provider: 'getsilt'
        })
      );

      // Check user was updated
      const updatedUser = await User.findById(user._id);
      expect(updatedUser.kycStatus).toBe('Verified');
      expect(updatedUser.isKycVerified).toBe(true);
      expect(updatedUser.kycVerificationDate).toBeTruthy();
    });

    it('should reject webhook with invalid signature', async () => {
      // Arrange
      GetSiltService.prototype.verifyWebhookSignature = jest.fn().mockResolvedValue(false);

      // Act & Assert
      await expect(kycManagerService.processWebhook(
        'getsilt', 
        {}, 
        'invalid_signature'
      )).rejects.toThrow('Invalid webhook signature');
    });

    it('should handle unknown provider', async () => {
      // Act & Assert
      await expect(kycManagerService.processWebhook(
        'unknown_provider', 
        {}
      )).rejects.toThrow('Unknown KYC provider: unknown_provider');
    });
  });

  describe('processUnifiedKycUpdate', () => {
    it('should update user status and create notification on verification', async () => {
      // Arrange
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        kycStatus: 'Pending'
      });

      const unifiedData = {
        userId: user._id.toString(),
        status: 'Verified',
        provider: 'getsilt',
        providerId: 'prov_123',
        reference: 'ref_123',
        reason: 'Verification successful'
      };

      const mockIo = {
        emit: jest.fn()
      };

      // Act
      const result = await kycManagerService.processUnifiedKycUpdate(unifiedData, mockIo);

      // Assert
      expect(result.success).toBe(true);
      expect(result.oldStatus).toBe('Pending');
      expect(result.newStatus).toBe('Verified');

      // Check user was updated
      const updatedUser = await User.findById(user._id);
      expect(updatedUser.kycStatus).toBe('Verified');
      expect(updatedUser.isKycVerified).toBe(true);
      expect(updatedUser.kycProvider).toBe('getsilt');
      expect(updatedUser.kycProviderUserId).toBe('prov_123');
      expect(updatedUser.kycAttempts).toHaveLength(1);
    });

    it('should handle rejection status correctly', async () => {
      // Arrange
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        kycStatus: 'Pending'
      });

      const unifiedData = {
        userId: user._id.toString(),
        status: 'Rejected',
        provider: 'shufti',
        reason: 'Document quality insufficient'
      };

      // Act
      const result = await kycManagerService.processUnifiedKycUpdate(unifiedData);

      // Assert
      expect(result.success).toBe(true);
      expect(result.newStatus).toBe('Rejected');

      // Check user was updated
      const updatedUser = await User.findById(user._id);
      expect(updatedUser.kycStatus).toBe('Rejected');
      expect(updatedUser.isKycVerified).toBe(false);
      expect(updatedUser.kycRejectionReason).toBe('Document quality insufficient');
    });
  });

  describe('error handling', () => {
    it('should handle database connection errors gracefully', async () => {
      // Arrange
      const originalFindById = User.findById;
      User.findById = jest.fn().mockRejectedValue(new Error('Database connection failed'));

      // Act & Assert
      await expect(kycManagerService.getProviderForUser('invalid_id'))
        .rejects.toThrow('Database connection failed');

      // Cleanup
      User.findById = originalFindById;
    });

    it('should handle provider service errors', async () => {
      // Arrange
      const investor = await Investor.create({
        investorType: 'Retail'
      });
      
      const user = await User.create({
        email: 'test@example.com',
        firstName: 'Test',
        lastName: 'User',
        investorId: investor._id
      });

      GetSiltService.prototype.initiateVerification = jest.fn()
        .mockRejectedValue(new Error('Provider service unavailable'));

      // Act & Assert
      await expect(kycManagerService.initiateVerification(user._id))
        .rejects.toThrow('Provider service unavailable');
    });
  });
});
