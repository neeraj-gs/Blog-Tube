## 12. Monitoring and Logging Implementation

### 12.1 KYC Metrics Service
```javascript
// api/services/kycMetrics.service.js - NEW METRICS TRACKING

import logger from '../config/logger.js';
import KycProvider from '../models/kycProvider.model.js';
import User from '../models/users.model.js';

class KycMetricsService {
  constructor() {
    this.startMetricsCollection();
  }
  
  async trackProviderUsage(providerName, operation, success = true, processingTime = 0) {
    try {
      const updateQuery = {
        $inc: {
          'statistics.totalVerifications': operation === 'verification' ? 1 : 0,
          'statistics.successfulVerifications': (operation === 'verification' && success) ? 1 : 0,
          'statistics.rejectedVerifications': (operation === 'verification' && !success) ? 1 : 0
        },
        $set: {
          'statistics.lastUsed': new Date()
        }
      };
      
      // Update average processing time
      if (processingTime > 0 && operation === 'verification') {
        const provider = await KycProvider.findOne({ name: providerName });
        if (provider) {
          const currentAvg = provider.statistics.averageProcessingTime || 0;
          const totalVerifications = provider.statistics.totalVerifications || 0;
          const newAvg = ((currentAvg * totalVerifications) + processingTime) / (totalVerifications + 1);
          updateQuery.$set['statistics.averageProcessingTime'] = Math.round(newAvg);
        }
      }
      
      await KycProvider.findOneAndUpdate(
        { name: providerName },
        updateQuery,
        { upsert: true }
      );
      
      logger.info('Provider usage tracked', {
        provider: providerName,
        operation,
        success,
        processingTime
      });
    } catch (error) {
      logger.error('Error tracking provider usage', {
        provider: providerName,
        operation,
        error: error.message
      });
    }
  }
  
  async generateDailyReport() {
    try {
      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);
      
      // Get daily KYC statistics
      const dailyStats = await User.aggregate([
        {
          $match: {
            'kycAttempts.attemptDate': {
              $gte: yesterday,
              $lt: today
            }
          }
        },
        {
          $unwind: '$kycAttempts'
        },
        {
          $match: {
            'kycAttempts.attemptDate': {
              $gte: yesterday,
              $lt: today
            }
          }
        },
        {
          $group: {
            _id: {
              provider: '$kycAttempts.provider',
              status: '$kycAttempts.status'
            },
            count: { $sum: 1 }
          }
        }
      ]);
      
      // Format report
      const report = {
        date: yesterday.toISOString().split('T')[0],
        providers: {},
        totals: {
          initiated: 0,
          verified: 0,
          rejected: 0,
          pending: 0
        }
      };
      
      dailyStats.forEach(stat => {
        const provider = stat._id.provider;
        const status = stat._id.status;
        const count = stat.count;
        
        if (!report.providers[provider]) {
          report.providers[provider] = {
            initiated: 0,
            verified: 0,
            rejected: 0,
            pending: 0
          };
        }
        
        report.providers[provider][status.toLowerCase()] = count;
        report.totals[status.toLowerCase()] += count;
      });
      
      // Get provider performance metrics
      const providers = await KycProvider.find({ isActive: true });
      for (const provider of providers) {
        if (report.providers[provider.name]) {
          report.providers[provider.name].averageProcessingTime = provider.statistics.averageProcessingTime;
          report.providers[provider.name].errorRate = this.calculateErrorRate(provider.statistics);
        }
      }
      
      logger.info('Daily KYC report generated', report);
      return report;
    } catch (error) {
      logger.error('Error generating daily report', {
        error: error.message
      });
      throw error;
    }
  }
  
  calculateErrorRate(statistics) {
    const total = statistics.totalVerifications || 0;
    const rejected = statistics.rejectedVerifications || 0;
    return total > 0 ? ((rejected / total) * 100).toFixed(2) : 0;
  }
  
  async getProviderHealthStatus() {
    try {
      const providers = await KycProvider.find({ isActive: true });
      const healthReport = [];
      
      for (const provider of providers) {
        const stats = provider.statistics;
        const errorRate = this.calculateErrorRate(stats);
        const lastUsed = stats.lastUsed;
        const daysSinceLastUse = lastUsed ? 
          Math.floor((new Date() - lastUsed) / (1000 * 60 * 60 * 24)) : null;
        
        let healthStatus = 'healthy';
        const issues = [];
        
        // Check error rate
        if (parseFloat(errorRate) > 20) {
          healthStatus = 'warning';
          issues.push(`High error rate: ${errorRate}%`);
        }
        
        // Check last usage
        if (daysSinceLastUse > 7) {
          healthStatus = 'warning';
          issues.push(`Not used for ${daysSinceLastUse} days`);
        }
        
        // Check processing time
        if (stats.averageProcessingTime > 300) { // 5 minutes
          healthStatus = 'warning';
          issues.push(`Slow processing: ${stats.averageProcessingTime} minutes`);
        }
        
        healthReport.push({
          provider: provider.name,
          displayName: provider.displayName,
          status: healthStatus,
          issues,
          statistics: {
            errorRate: `${errorRate}%`,
            averageProcessingTime: `${stats.averageProcessingTime} min`,
            totalVerifications: stats.totalVerifications,
            lastUsed: lastUsed ? lastUsed.toISOString() : 'Never'
          }
        });
      }
      
      return healthReport;
    } catch (error) {
      logger.error('Error getting provider health status', {
        error: error.message
      });
      throw error;
    }
  }
  
  startMetricsCollection() {
    // Generate daily report at midnight
    const scheduleDaily = () => {
      const now = new Date();
      const tomorrow = new Date(now);
      tomorrow.setDate(tomorrow.getDate() + 1);
      tomorrow.setHours(0, 0, 0, 0);
      
      const msUntilMidnight = tomorrow.getTime() - now.getTime();
      
      setTimeout(() => {
        this.generateDailyReport();
        // Schedule next day
        setInterval(() => {
          this.generateDailyReport();
        }, 24 * 60 * 60 * 1000); // 24 hours
      }, msUntilMidnight);
    };
    
    scheduleDaily();
    
    // Check provider health every hour
    setInterval(() => {
      this.getProviderHealthStatus();
    }, 60 * 60 * 1000); // 1 hour
    
    logger.info('KYC metrics collection started');
  }
}

export default new KycMetricsService();
```

