## 7. Validation Implementation

### 7.1 KYC Validation Rules
```javascript
// api/validator/kyc.validator.js - NEW KYC VALIDATION

import { body, param, header, validationResult } from 'express-validator';
import { handleResponse } from '../responseHandler.js';

const handleValidationErrors = (req, res, next) => {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    const firstError = errors.array()[0];
    return handleResponse(req, res, firstError.msg, null);
  }
  next();
};

export const validateKycInitiation = [
  param('userId')
    .trim()
    .notEmpty()
    .withMessage('UserId is required')
    .isMongoId()
    .withMessage('Invalid UserId format'),
  handleValidationErrors,
];

export const validateKycStatus = [
  param('userId')
    .trim()
    .notEmpty()
    .withMessage('UserId is required')
    .isMongoId()
    .withMessage('Invalid UserId format'),
  handleValidationErrors,
];

export const validateWebhookProvider = [
  header('x-provider-type')
    .optional()
    .isIn(['getsilt', 'shufti', 'jumio', 'onfido'])
    .withMessage('Invalid provider type'),
  body()
    .custom((value, { req }) => {
      // Basic webhook payload validation
      if (!req.body || typeof req.body !== 'object') {
        throw new Error('Invalid webhook payload');
      }
      return true;
    }),
  handleValidationErrors,
];

export const validateProviderWebhook = (providerType) => [
  body()
    .custom((value, { req }) => {
      switch (providerType) {
        case 'getsilt':
          if (!req.body.user_id) {
            throw new Error('GetSilt webhook missing user_id');
          }
          break;
        case 'shufti':
          if (!req.body.reference || !req.body.event) {
            throw new Error('Shufti webhook missing required fields');
          }
          break;
        default:
          throw new Error(`Unknown provider type: ${providerType}`);
      }
      return true;
    }),
  handleValidationErrors,
];
```

## 8. Middleware Enhancements

### 8.1 Enhanced Authentication Middleware
```javascript
// api/middleware/verifyApiKeyOrToken.js - ADD KYC API KEY SUPPORT

// ... existing imports ...
import { KYC_API_KEY } from '../constants/env_var.js';

// ... existing middleware functions ...

const verifyKycApiKey = async (req, res, next) => {
  try {
    const apiKey = req.get('X-KYC-API-Key');

    if (!apiKey) {
      return handleResponse(req, res, message.error.UNAUTHORIZED, null);
    }

    if (apiKey !== KYC_API_KEY) {
      return handleResponse(req, res, message.error.UNAUTHORIZED, null);
    }

    // Set user context for KYC operations
    req.user = { 
      role: 'kyc_service', 
      source: 'kyc_api_key',
      permissions: ['kyc:webhook', 'kyc:process']
    };

    next();
  } catch (error) {
    logger.error('KYC API Key Verification Error:', error);
    return handleResponse(req, res, message.error.UNAUTHORIZED, null);
  }
};

// Enhanced API key verification with KYC support
const verifyApiKeyOrTokenEnhanced = async (req, res, next) => {
  try {
    // Check for KYC API key first
    const kycApiKey = req.get('X-KYC-API-Key');
    if (kycApiKey) {
      return verifyKycApiKey(req, res, next);
    }

    // Check for master API keys
    const apiKey = req.get('X-API-Key');
    if (apiKey) {
      if (apiKey === MASTER_API_KEY || apiKey === VERIFY_ADMIN_API_KEY) {
        req.user = { 
          role: 'admin', 
          source: 'api_key',
          permissions: ['*']
        };
        return next();
      } else {
        return handleResponse(req, res, message.error.UNAUTHORIZED, null);
      }
    }

    // Fall back to JWT verification
    return verifyJwtToken(req, res, next);
  } catch (error) {
    logger.error('Enhanced API Key/Token Verification Error:', error);
    return handleResponse(req, res, message.error.UNAUTHORIZED, null);
  }
};

// Export enhanced functions
export {
  verifyJwtToken,
  verifyTokenOrRole,
  verifyToken,
  verifyHeaderApiKey,
  verifyHeaderAdminApiKey,
  verifyKycApiKey, // New
  verifyApiKeyOrTokenEnhanced, // Enhanced
  allowedRoles,
  verifyCompanyProject,
  verifyIfUserIsWhitelisted,
};
```

