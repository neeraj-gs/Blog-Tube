### 3.1 Enhanced User Model
```javascript
// api/models/users.model.js - ADD THESE FIELDS

const userSchema = new mongoose.Schema({
  // ... existing fields ...
  
  // Enhanced KYC Provider Tracking
  kycProvider: {
    type: String,
