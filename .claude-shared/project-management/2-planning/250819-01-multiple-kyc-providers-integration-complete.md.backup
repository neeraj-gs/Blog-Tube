### 10.2 Provider Service Tests
```javascript
// __tests__/services/providers/shufti.service.test.js - NEW SHUFTI TESTS

import ShuftiService from '../../../services/providers/shufti.service.js';
import crypto from 'crypto';

// Mock crypto module for testing
jest.mock('crypto');

global.fetch = jest.fn();

describe('ShuftiService', () => {
  let shuftiService;
  
  beforeEach(() => {
    shuftiService = new ShuftiService();
    jest.clearAllMocks();
    
    // Mock environment variables
    process.env.SHUFTI_CLIENT_ID = 'test_client_id';
    process.env.SHUFTI_SECRET_KEY = 'test_secret_key';
    process.env.SHUFTI_BASE_URL = 'https://api.shuftipro.com';
  });

  describe('initiateVerification', () => {
    it('should create proper verification payload for accredited investor', async () => {
      // Arrange
      const user = {
        _id: 'user123',
        email: 'accredited@test.com',
        firstName: 'John',
        lastName: 'Doe',
        countryOfResidence: 'US'
      };

      const investor = {
        investorType: 'Accredited',
        dateOfBirth: '1980-01-01'
      };

      const mockResponse = {
        verification_url: 'https://verify.shuftipro.com/12345',
        verification_id: 'shufti_12345',
        event: 'request.received'
      };

      fetch.mockResolvedValue({
        ok: true,
        json: () => Promise.resolve(mockResponse)
      });

      // Act
      const result = await shuftiService.initiateVerification(user, investor);

      // Assert
      expect(result.provider).toBe('shufti');
      expect(result.verificationUrl).toBe(mockResponse.verification_url);
      expect(result.providerId).toBe(mockResponse.verification_id);
      
      // Check API call was made with correct payload
      expect(fetch).toHaveBeenCalledWith(
        'https://api.shuftipro.com/',
        expect.objectContaining({
          method: 'POST',
          headers: expect.objectContaining({
            'Content-Type': 'application/json',
            'Authorization': expect.stringContaining('Basic')
          }),
          body: expect.stringContaining('accredited@test.com')
        })
      );
    });

    it('should handle API errors gracefully', async () => {
      // Arrange
      const user = { _id: 'user123', email: 'test@test.com' };
      const investor = { investorType: 'Accredited' };

      fetch.mockResolvedValue({
        ok: false,
        status: 400,
        statusText: 'Bad Request',
        text: () => Promise.resolve('Invalid request')
      });

      // Act
      const result = await shuftiService.initiateVerification(user, investor);

      // Assert
      expect(result.success).toBe(false);
      expect(result.error).toContain('Shufti API error: 400');
    });
  });

  describe('parseWebhook', () => {
    it('should parse verification accepted webhook correctly', async () => {
      // Arrange
      const webhookData = {
        reference: 'penomo_shufti_user123_1234567890_abcd',
        event: 'verification.accepted',
        verification_id: 'shufti_12345',
        verification_data: {
          document: {
            status: 'accepted',
            first_name: 'John',
            last_name: 'Doe',
            dob: '1980-01-01',
            document_number: 'P123456789',
            country: 'US'
          },
          face: {
            status: 'accepted'
          },
          address: {
            status: 'accepted'
          }
        }
      };

      // Act
      const result = await shuftiService.parseWebhook(webhookData);

      // Assert
      expect(result.userId).toBe('user123');
      expect(result.provider).toBe('shufti');
      expect(result.status).toBe('Verified');
      expect(result.providerId).toBe('shufti_12345');
      expect(result.personalInfo.firstName).toBe('John');
      expect(result.personalInfo.lastName).toBe('Doe');
      expect(result.documents).toHaveLength(3); // document, face, address
    });

    it('should parse verification declined webhook correctly', async () => {
      // Arrange
      const webhookData = {
        reference: 'penomo_shufti_user456_1234567890_efgh',
        event: 'verification.declined',
        verification_id: 'shufti_67890',
        decline_reason: 'Document quality insufficient'
      };

      // Act
      const result = await shuftiService.parseWebhook(webhookData);

      // Assert
      expect(result.userId).toBe('user456');
      expect(result.status).toBe('Rejected');
      expect(result.reason).toBe('Document quality insufficient');
    });

    it('should handle unknown events', async () => {
      // Arrange
      const webhookData = {
        reference: 'penomo_shufti_user789_1234567890_ijkl',
        event: 'unknown.event',
        verification_id: 'shufti_99999'
      };

      // Act
      const result = await shuftiService.parseWebhook(webhookData);

      // Assert
      expect(result.status).toBe('Unknown');
      expect(result.reason).toBe('Unknown event: unknown.event');
    });

    it('should throw error for invalid reference format', async () => {
      // Arrange
      const webhookData = {
        reference: 'invalid_reference_format',
        event: 'verification.accepted'
      };

      // Act & Assert
      await expect(shuftiService.parseWebhook(webhookData))
        .rejects.toThrow('Invalid reference format');
    });
  });

  describe('verifyWebhookSignature', () => {
    it('should verify valid signature correctly', async () => {
      // Arrange
      const payload = { test: 'data' };
      const secretKey = 'test_secret_key';
      const hashedSecret = 'hashed_secret';
      const expectedSignature = 'expected_signature';

      // Mock crypto functions
      const mockHash = {
        update: jest.fn().mockReturnThis(),
        digest: jest.fn()
      };

      crypto.createHash = jest.fn()
        .mockReturnValueOnce({ ...mockHash, digest: () => hashedSecret })
        .mockReturnValueOnce({ ...mockHash, digest: () => expectedSignature });

      crypto.timingSafeEqual = jest.fn().mockReturnValue(true);

      // Act
      const result = await shuftiService.verifyWebhookSignature(payload, expectedSignature);

      // Assert
      expect(result).toBe(true);
      expect(crypto.createHash).toHaveBeenCalledWith('sha256');
      expect(crypto.timingSafeEqual).toHaveBeenCalled();
    });

    it('should reject invalid signature', async () => {
      // Arrange
      crypto.timingSafeEqual = jest.fn().mockReturnValue(false);
      crypto.createHash = jest.fn().mockReturnValue({
        update: jest.fn().mockReturnThis(),
        digest: jest.fn().mockReturnValue('different_signature')
      });

      // Act
      const result = await shuftiService.verifyWebhookSignature({}, 'invalid_signature');

      // Assert
      expect(result).toBe(false);
    });

    it('should handle signature verification errors', async () => {
      // Arrange
      crypto.createHash = jest.fn().mockImplementation(() => {
        throw new Error('Crypto error');
      });

      // Act
      const result = await shuftiService.verifyWebhookSignature({}, 'signature');

      // Assert
      expect(result).toBe(false);
    });
  });

  describe('getAuthHeaders', () => {
    it('should create proper basic auth header', () => {
      // Arrange
      const expectedCredentials = Buffer.from('test_client_id:test_secret_key').toString('base64');

      // Act
      const headers = shuftiService.getAuthHeaders();

      // Assert
      expect(headers.Authorization).toBe(`Basic ${expectedCredentials}`);
      expect(headers['Content-Type']).toBe('application/json');
    });
  });

  describe('extractUserIdFromReference', () => {
    it('should extract user ID from properly formatted reference', () => {
      // Arrange
      const reference = 'penomo_shufti_user123_1234567890_abcd';

      // Act
      const userId = shuftiService.extractUserIdFromReference(reference);

      // Assert
      expect(userId).toBe('user123');
    });

    it('should throw error for malformed reference', () => {
      // Arrange
      const reference = 'invalid_format';

      // Act & Assert
      expect(() => shuftiService.extractUserIdFromReference(reference))
        .toThrow('Invalid reference format');
    });
  });
});
```

### 10.3 Controller Integration Tests
```javascript
// __tests__/controllers/kyc.controller.test.js - COMPREHENSIVE CONTROLLER TESTS

import request from 'supertest';
import app from '../../server.js';
import User from '../../models/users.model.js';
import Investor from '../../models/investor.model.js';
import kycManagerService from '../../services/kycManager.service.js';

jest.mock('../../services/kycManager.service.js');

describe('KYC Controller Integration Tests', () => {
  let testUser, testInvestor, authToken;

  beforeEach(async () => {
    // Clear database
    await User.deleteMany({});
    await Investor.deleteMany({});

    // Create test investor
    testInvestor = await Investor.create({
      investorType: 'Retail',
      financialKnowledge: 'Basic'
    });

    // Create test user
    testUser = await User.create({
      email: 'test@example.com',
      firstName: 'Test',
      lastName: 'User',
      investorId: testInvestor._id,
      kycStatus: 'Not Submitted'
    });

    // Mock auth token (would normally be generated through login)
    authToken = 'mock_jwt_token';
    
    // Clear all mocks
    jest.clearAllMocks();
  });

  describe('POST /api/kyc/initiate/:userId', () => {
    it('should initiate KYC verification successfully', async () => {
      // Arrange
      const mockResult = {
        success: true,
        provider: 'getsilt',
        verificationUrl: 'https://getsilt.com/verify/123',
        reference: 'ref_123',
        providerId: 'getsilt_123'
      };

      kycManagerService.initiateVerification = jest.fn().mockResolvedValue(mockResult);

      // Act
      const response = await request(app)
        .post(`/api/kyc/initiate/${testUser._id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.message).toBe('KYC verification initiated successfully');
      expect(response.body.data.provider).toBe('getsilt');
      expect(response.body.data.verificationUrl).toBe('https://getsilt.com/verify/123');
      
      expect(kycManagerService.initiateVerification)
        .toHaveBeenCalledWith(testUser._id.toString());
    });

    it('should return 400 for invalid user ID format', async () => {
      // Act
      const response = await request(app)
        .post('/api/kyc/initiate/invalid_id')
        .set('Authorization', `Bearer ${authToken}`)
        .expect(400);

      // Assert
      expect(response.body.success).toBe(false);
      expect(response.body.message).toContain('Invalid UserId format');
    });

    it('should return 401 for unauthorized access', async () => {
      // Act
      const response = await request(app)
        .post(`/api/kyc/initiate/${testUser._id}`)
        .expect(401);

      // Assert
      expect(response.body.success).toBe(false);
    });

    it('should handle service errors gracefully', async () => {
      // Arrange
      kycManagerService.initiateVerification = jest.fn()
        .mockRejectedValue(new Error('Provider service unavailable'));

      // Act
      const response = await request(app)
        .post(`/api/kyc/initiate/${testUser._id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .expect(500);

      // Assert
      expect(response.body.success).toBe(false);
    });
  });

  describe('GET /api/kyc/status/:userId', () => {
    it('should return KYC status successfully', async () => {
      // Arrange
      testUser.kycStatus = 'Verified';
      testUser.kycProvider = 'getsilt';
      testUser.kycProviderUserId = 'getsilt_123';
      testUser.kycVerificationDate = new Date();
      testUser.kycAttempts = [{
        provider: 'getsilt',
        attemptDate: new Date(),
        status: 'Verified',
        reason: 'Verification successful'
      }];
      await testUser.save();

      // Act
      const response = await request(app)
        .get(`/api/kyc/status/${testUser._id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.data.kycStatus).toBe('Verified');
      expect(response.body.data.provider).toBe('getsilt');
      expect(response.body.data.attempts).toBe(1);
      expect(response.body.data.investorType).toBe('Retail');
    });

    it('should return 404 for non-existent user', async () => {
      // Arrange
      const nonExistentId = '507f1f77bcf86cd799439011';

      // Act
      const response = await request(app)
        .get(`/api/kyc/status/${nonExistentId}`)
        .set('Authorization', `Bearer ${authToken}`)
        .expect(400);

      // Assert
      expect(response.body.success).toBe(false);
    });
  });

  describe('POST /api/kyc/webhook/unified', () => {
    it('should process GetSilt webhook successfully', async () => {
      // Arrange
      const webhookPayload = {
        user_id: testUser._id.toString(),
        notification_id: 'notif_123',
        user: {
          status: 'SUCCESS',
          first_name: 'Test',
          last_name: 'User'
        }
      };

      const mockResult = {
        success: true,
        status: 'Verified',
        provider: 'getsilt',
        userId: testUser._id.toString()
      };

      kycManagerService.processWebhook = jest.fn().mockResolvedValue(mockResult);

      // Act
      const response = await request(app)
        .post('/api/kyc/webhook/unified')
        .set('X-Provider-Type', 'getsilt')
        .send(webhookPayload)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(response.body.message).toBe('Webhook processed successfully');
      expect(response.body.data.status).toBe('Verified');
      
      expect(kycManagerService.processWebhook).toHaveBeenCalledWith(
        'getsilt',
        webhookPayload,
        undefined, // No signature in test
        expect.any(Object) // Socket.io instance
      );
    });

    it('should process Shufti webhook successfully', async () => {
      // Arrange
      const webhookPayload = {
        reference: `penomo_shufti_${testUser._id}_1234567890_abcd`,
        event: 'verification.accepted',
        verification_id: 'shufti_123'
      };

      const mockResult = {
        success: true,
        status: 'Verified',
        provider: 'shufti',
        userId: testUser._id.toString()
      };

      kycManagerService.processWebhook = jest.fn().mockResolvedValue(mockResult);

      // Act
      const response = await request(app)
        .post('/api/kyc/webhook/shufti')
        .send(webhookPayload)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(kycManagerService.processWebhook).toHaveBeenCalledWith(
        'shufti',
        webhookPayload,
        undefined,
        expect.any(Object)
      );
    });

    it('should handle webhook signature verification', async () => {
      // Arrange
      const webhookPayload = { test: 'data' };
      const signature = 'webhook_signature_123';

      kycManagerService.processWebhook = jest.fn().mockResolvedValue({
        success: true,
        status: 'Verified'
      });

      // Act
      const response = await request(app)
        .post('/api/kyc/webhook/getsilt')
        .set('X-Signature', signature)
        .send(webhookPayload)
        .expect(200);

      // Assert
      expect(kycManagerService.processWebhook).toHaveBeenCalledWith(
        'getsilt',
        webhookPayload,
        signature,
        expect.any(Object)
      );
    });

    it('should return 400 for unknown provider type', async () => {
      // Act
      const response = await request(app)
        .post('/api/kyc/webhook/unified')
        .send({ test: 'data' })
        .expect(400);

      // Assert
      expect(response.body.success).toBe(false);
      expect(response.body.message).toContain('Unknown provider type');
    });

    it('should handle webhook processing errors', async () => {
      // Arrange
      kycManagerService.processWebhook = jest.fn()
        .mockRejectedValue(new Error('Webhook processing failed'));

      // Act
      const response = await request(app)
        .post('/api/kyc/webhook/getsilt')
        .send({ test: 'data' })
        .expect(500);

      // Assert
      expect(response.body.success).toBe(false);
    });
  });

  describe('Rate Limiting', () => {
    it('should apply rate limiting to KYC initiation', async () => {
      // Arrange
      kycManagerService.initiateVerification = jest.fn().mockResolvedValue({
        success: true,
        provider: 'getsilt'
      });

      // Act - Make multiple rapid requests
      const requests = Array(15).fill().map(() =>
        request(app)
          .post(`/api/kyc/initiate/${testUser._id}`)
          .set('Authorization', `Bearer ${authToken}`)
      );

      const responses = await Promise.all(requests);

      // Assert - Some requests should be rate limited
      const rateLimitedResponses = responses.filter(res => res.status === 429);
      expect(rateLimitedResponses.length).toBeGreaterThan(0);
    });
  });

  describe('Backward Compatibility', () => {
    it('should handle legacy GetSilt webhook endpoint', async () => {
      // Arrange
      const legacyPayload = {
        user_id: testUser._id.toString(),
        notification_id: 'legacy_notif',
        user: { status: 'SUCCESS' }
      };

      kycManagerService.processWebhook = jest.fn().mockResolvedValue({
        success: true,
        status: 'Verified'
      });

      // Act
      const response = await request(app)
        .post('/api/user/webhook/silt')
        .send(legacyPayload)
        .expect(200);

      // Assert
      expect(response.body.success).toBe(true);
      expect(kycManagerService.processWebhook).toHaveBeenCalledWith(
        'getsilt', // Should be automatically set for legacy endpoint
        legacyPayload,
        undefined,
        expect.any(Object)
      );
    });
  });
});
```

## 11. Database Migration Script

### 11.1 KYC Data Migration
```javascript
// migrations/001_add_kyc_provider_fields.js - DATABASE MIGRATION SCRIPT

import mongoose from 'mongoose';
import User from '../api/models/users.model.js';
import KycProvider from '../api/models/kycProvider.model.js';
import logger from '../api/config/logger.js';

export const up = async () => {
  try {
    logger.info('Starting KYC provider fields migration...');

    // 1. Add indexes for new fields
    await User.collection.createIndex({ kycProvider: 1, kycProviderUserId: 1 });
    await User.collection.createIndex({ 'kycAttempts.provider': 1, 'kycAttempts.status': 1 });
    await User.collection.createIndex({ kycStatus: 1, kycProvider: 1 });

    logger.info('Created indexes for KYC provider fields');

    // 2. Initialize kycAttempts array for existing users
    const usersWithoutAttempts = await User.countDocuments({
      kycAttempts: { $exists: false }
    });

    if (usersWithoutAttempts > 0) {
      await User.updateMany(
        { kycAttempts: { $exists: false } },
        { $set: { kycAttempts: [] } }
      );
      logger.info(`Initialized kycAttempts for ${usersWithoutAttempts} users`);
    }

    // 3. Set kycProvider for existing verified users
    const verifiedUsers = await User.find({
      kycStatus: 'Verified',
      kycProvider: { $exists: false }
    });

    if (verifiedUsers.length > 0) {
      await User.updateMany(
        { 
          kycStatus: 'Verified',
          kycProvider: { $exists: false }
        },
        { 
          $set: { 
            kycProvider: 'getsilt', // Assume existing verified users used GetSilt
            kycVerificationDate: new Date() // Set current date as placeholder
          }
        }
      );
      logger.info(`Set kycProvider to 'getsilt' for ${verifiedUsers.length} existing verified users`);
    }

    // 4. Create default KYC provider configurations
    const defaultProviders = [
      {
        name: 'getsilt',
        displayName: 'GetSilt',
        isActive: true,
        supportedInvestorTypes: ['Retail'],
        priority: 8,
        configuration: {
          baseUrl: process.env.GETSILT_BASE_URL || 'https://api.getsilt.com',
          webhookUrl: `${process.env.PENOMO_BACKEND}/api/kyc/webhook/getsilt`,
          supportedDocuments: ['passport', 'id_card', 'driving_license'],
          supportedCountries: ['US', 'CA', 'GB', 'EU'],
          maxRetryAttempts: 3
        },
        statistics: {
          totalVerifications: 0,
          successfulVerifications: 0,
          rejectedVerifications: 0,
          averageProcessingTime: 0
        }
      },
      {
        name: 'shufti',
        displayName: 'Shufti Pro',
        isActive: true,
        supportedInvestorTypes: ['Accredited', 'Institutional'],
        priority: 9,
        configuration: {
          baseUrl: process.env.SHUFTI_BASE_URL || 'https://api.shuftipro.com',
          webhookUrl: `${process.env.PENOMO_BACKEND}/api/kyc/webhook/shufti`,
          supportedDocuments: ['passport', 'id_card', 'driving_license', 'utility_bill'],
          supportedCountries: ['US', 'CA', 'GB', 'EU', 'AU'],
          maxRetryAttempts: 3
        },
        statistics: {
          totalVerifications: 0,
          successfulVerifications: 0,
          rejectedVerifications: 0,
          averageProcessingTime: 0
        }
      }
    ];

    for (const providerData of defaultProviders) {
      await KycProvider.findOneAndUpdate(
        { name: providerData.name },
        providerData,
        { upsert: true, new: true }
      );
    }

    logger.info('Created default KYC provider configurations');

    // 5. Migrate existing GetSilt webhook logs to attempts format
    const getSiltUsers = await User.find({
      kycStatus: { $in: ['Verified', 'Rejected'] },
      kycProvider: 'getsilt',
      'kycAttempts.0': { $exists: false } // No attempts recorded yet
    });

    for (const user of getSiltUsers) {
      const attempt = {
        provider: 'getsilt',
        attemptDate: user.kycVerificationDate || user.updatedAt,
        status: user.kycStatus,
        reason: user.kycStatus === 'Verified' ? 'Verification successful' : user.kycRejectionReason || 'Verification failed'
      };

      await User.findByIdAndUpdate(
        user._id,
        { $push: { kycAttempts: attempt } }
      );
    }

    logger.info(`Created KYC attempts records for ${getSiltUsers.length} existing users`);

    logger.info('KYC provider fields migration completed successfully');
  } catch (error) {
    logger.error('Error during KYC provider fields migration:', error);
    throw error;
  }
};

export const down = async () => {
  try {
    logger.info('Rolling back KYC provider fields migration...');

    // 1. Remove new fields from users
    await User.updateMany(
      {},
      {
        $unset: {
          kycProvider: 1,
          kycProviderUserId: 1,
          kycAttempts: 1,
          kycVerificationDate: 1,
          kycRejectionReason: 1
        }
      }
    );

    // 2. Drop indexes
    try {
      await User.collection.dropIndex({ kycProvider: 1, kycProviderUserId: 1 });
      await User.collection.dropIndex({ 'kycAttempts.provider': 1, 'kycAttempts.status': 1 });
      await User.collection.dropIndex({ kycStatus: 1, kycProvider: 1 });
    } catch (indexError) {
      logger.warn('Some indexes may not exist:', indexError.message);
    }

    // 3. Remove KYC provider configurations
    await KycProvider.deleteMany({});

    logger.info('KYC provider fields migration rollback completed');
  } catch (error) {
    logger.error('Error during migration rollback:', error);
    throw error;
  }
};

// Migration runner
export const runMigration = async () => {
  try {
    await mongoose.connect(process.env.MONGO_URI);
    await up();
    await mongoose.disconnect();
    console.log('Migration completed successfully');
  } catch (error) {
    console.error('Migration failed:', error);
    process.exit(1);
  }
};

// Run migration if called directly
if (import.meta.url === `file://${process.argv[1]}`) {
  runMigration();
}
```

